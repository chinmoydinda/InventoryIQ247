<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="860" prefWidth="1440" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.ui.controller.MainController">
    <left>
        <VBox spacing="8" styleClass="sidebar" prefWidth="224" minWidth="224">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand">
                <Label text="iq" styleClass="brand-mark"/>
                <VBox spacing="3"><Label text="InventoryIQ" styleClass="brand-name"/><Label text="247 / WORKSPACE" styleClass="brand-caption"/></VBox>
            </HBox>
            <Label text="WORKSPACE" styleClass="nav-caption"/>
            <Button fx:id="navDashboardBtn" text="Overview" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button fx:id="navProductsBtn" text="Products" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button fx:id="navBundlesBtn" text="Bundles" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Button fx:id="navAuditBtn" text="Stock activity" styleClass="sidebar-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="8" styleClass="sidebar-footer"><Label text="YOUR INVENTORY, ORGANIZED" styleClass="brand-caption" wrapText="true"/><Label text="Desktop workspace" styleClass="sidebar-note"/><Label text="InventoryIQ247" styleClass="sidebar-note"/></VBox>
        </VBox>
    </left>
    <center>
        <VBox styleClass="background-pane">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
                <Label text="Workspace" styleClass="text-muted"/><Label text="/" styleClass="text-muted"/><Label fx:id="currentPageLabel" text="Overview" styleClass="breadcrumb"/>
                <Region HBox.hgrow="ALWAYS"/><Label text="LOCAL WORKSPACE" styleClass="status-chip"/>
            </HBox>
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" minHeight="0"/>
        </VBox>
    </center>
</BorderPane>
